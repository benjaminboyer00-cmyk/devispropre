generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum DevisStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  FACTURE
}

enum FactureStatus {
  BROUILLON
  EMISE
  PAYEE
  ANNULEE
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  LOCK
  SEND
  REMINDER_SCHEDULED
  ACCEPT
  REFUSE
  CONVERT_TO_FACTURE
  VERIFY_HASH
  ISSUE
  PAY
  CANCEL
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  plan         Plan      @default(FREE)
  stripeCustomerId String? @unique
  subscriptionPastDue Boolean @default(false)
  sessionVersion   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company   Company?
  clients   Client[]
  devis     Devis[]
  factures  Facture[]
  auditLogs AuditLog[]
  attestations Attestation[]
  teamOwned Team? @relation("TeamOwner")
  teamMembership TeamMember?
  supportTickets SupportTicket[]
  magicLinkTokens MagicLinkToken[]
  sessions        UserSession[]
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Team {
  id         String   @id @default(cuid())
  ownerId    String   @unique
  owner      User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  maxMembers Int      @default(5)
  createdAt  DateTime @default(now())
  members    TeamMember[]
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

model TeamMember {
  id         String           @id @default(cuid())
  teamId     String
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String?          @unique
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  role       TeamRole         @default(MEMBER)
  status     TeamMemberStatus @default(PENDING)
  invitedAt  DateTime         @default(now())
  acceptedAt DateTime?

  @@unique([teamId, email])
  @@index([teamId])
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  priority  Boolean             @default(false)
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
}

model Company {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raisonSociale String
  siret         String
  adresse       String
  codePostal    String
  ville         String
  tvaIntracom   String?
  logoUrl       String?
  telephone     String?
  email         String?
  capitalSocial String?
  rcs           String?
  assurances    String?
  assuranceDecennaleAssureur   String?
  assuranceDecennaleContrat    String?
  assuranceDecennaleCouverture String?
  activiteBtp                  Boolean  @default(false)
  tvaApplicable Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom       String
  email     String?
  telephone String?
  adresse   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devis    Devis[]
  factures Facture[]
}

model Devis {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  numero         String
  status         DevisStatus @default(BROUILLON)
  totalHT        Float       @default(0)
  totalTVA       Float       @default(0)
  totalTTC       Float       @default(0)
  tauxTVA        Float       @default(20)
  lockedAt       DateTime?
  contentHash    String?
  chainHash      String?
  shareToken     String?     @unique
  sentAt         DateTime?
  acceptedAt     DateTime?
  refusedAt      DateTime?
  clientAcceptanceText String?
  clientSignatureData  String?
  reminderSentAt DateTime?
  pdfUrl         String?
  pdfArchivedAt  DateTime?
  issuerSnapshot Json?
  notes          String?
  validUntil     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  lignes    DevisLigne[]
  facture   Facture?
  auditLogs AuditLog[] @relation("DevisAudit")

  @@unique([userId, numero])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, sentAt, reminderSentAt])
}

model DevisLigne {
  id             String @id @default(cuid())
  devisId        String
  devis          Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ordre          Int
  description    String
  quantite       Float
  prixUnitaireHT Float
  tva            Float
  totalHT        Float
  @@index([devisId])
}

model Facture {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  devisId      String?       @unique
  devis        Devis?        @relation(fields: [devisId], references: [id])
  numero       String
  status       FactureStatus @default(BROUILLON)
  totalHT      Float         @default(0)
  totalTVA     Float         @default(0)
  totalTTC     Float         @default(0)
  tauxTVA      Float         @default(20)
  lockedAt     DateTime?
  contentHash  String?
  chainHash    String?
  previousHash String?
  shareToken   String?       @unique
  issuedAt     DateTime?
  paidAt       DateTime?
  pdfUrl       String?
  pdfArchivedAt DateTime?
  issuerSnapshot Json?
  notes        String?
  dateEcheance DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  lignes      FactureLigne[]
  attestation Attestation?
  auditLogs   AuditLog[] @relation("FactureAudit")

  @@unique([userId, numero])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model FactureLigne {
  id             String  @id @default(cuid())
  factureId      String
  facture        Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  ordre          Int
  description    String
  quantite       Float
  prixUnitaireHT Float
  tva            Float
  totalHT        Float
  @@index([factureId])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  action      AuditAction
  entityType  String
  entityId    String
  devisId     String?
  devis       Devis?      @relation("DevisAudit", fields: [devisId], references: [id])
  factureId   String?
  facture     Facture?    @relation("FactureAudit", fields: [factureId], references: [id])
  metadata    String
  ipAddress   String?
  userAgent   String?
  contentHash String?
  createdAt   DateTime    @default(now())

  @@index([userId, entityType, entityId])
  @@index([createdAt])
}

model Attestation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  factureId   String   @unique
  facture     Facture  @relation(fields: [factureId], references: [id], onDelete: Restrict)
  numero      String   @unique
  contentHash String
  signedAt    DateTime @default(now())
  pdfUrl        String?
  pdfArchivedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

/** Réponses mises en cache pour Idempotency-Key (double-clic réseau). */
model IdempotencyRecord {
  id        String   @id @default(cuid())
  userId    String
  key       String
  status    Int
  body      Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}

/** Idempotence webhooks Stripe — évite le double traitement d'un même event.id. */
model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model DocumentCounter {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  docType   String
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, year, docType])
}
