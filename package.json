{
  "name": "devispropre",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:clean": "prisma generate && rm -rf .next && bash scripts/dev/kill-dev-port.sh && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker start devispropre_postgres 2>/dev/null || docker run -d --name devispropre_postgres -e POSTGRES_USER=devispropre -e POSTGRES_PASSWORD=devispropre -e POSTGRES_DB=devispropre -p 5433:5432 postgres:16-alpine",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "deploy": "bash scripts/deploy.sh",
    "backup:db": "bash scripts/backup-db.sh",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/__tests__/prisma",
    "audit:idor": "vitest run src/lib/__tests__/idor-routes-audit.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "posthog-js": "^1.376.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
